extends SceneTree
const C=preload("res://scripts/compact_wallet.gd")
const N=preload("res://scripts/growth_number.gd")
const I=preload("res://scripts/reactor_integer.gd")
var failures:=0
func check(ok:bool,label:String)->void:
	if not ok:failures+=1;printerr("FAIL ",label)
func _initialize()->void:
	var base={"m":1.0,"e":1000000000.0}
	var spent=C.change(base,15,-1)
	var restored=C.change(spent,15,1)
	print("COMPACT spent=",spent," valid=",N.valid(spent))
	print("COMPACT restored=",restored," valid=",N.valid(restored)," cmp=",N.compare(restored,spent))
	var parsed=JSON.parse_string(JSON.stringify(spent))
	print("COMPACT parsed=",parsed," valid=",N.valid(parsed)," cmp=",N.compare(parsed,spent))
	check(N.valid(parsed) and N.compare(parsed,spent)==0,"JSON compact meaning")
	check(N.compare(restored,spent)>0,"refund restores greater balance")
	check(not preload("res://scripts/number_format.gd").compact(spent).contains("INF") and preload("res://scripts/number_format.gd").compact(spent).contains("-15"),"compact wallet display exposes exact adjustment")
	var a=C.change({"m":1.0,"e":6.0},500,-1)
	var b=C.change({"m":9.99,"e":5.0},500,1)
	check(N.compare(a,b)==0,"different bases compare after carry")
	check(N.compare(a,999500)==0,"compact versus small integer")
	check(N.compare(a,{"m":9.995,"e":5.0})==0,"compact versus old base")
	var growth_income=N.add(spent,{"m":1.0,"e":400.0})
	check(N.valid(growth_income) and N.compare(growth_income,spent)>0,"legacy growth income retained in compact delta")
	check(N.compare(N.subtract(growth_income,{"m":1.0,"e":400.0}),spent)==0,"legacy growth income reverses")
	var merged=N.add(spent,{"m":1.0,"e":1000000000.0})
	check(N.valid(merged) and N.compare(merged,C.change({"m":2.0,"e":1000000000.0},15,-1))==0,"same-exponent exact base income merges")
	check(I.compare(N.subtract(spent,C.change(spent,5,-1)),5)==0,"same-base compact wallet difference exact")
	var large_delta=C.change(base,I.make("9007199254740993"),-1)
	check(N.valid(large_delta) and large_delta.delta is Dictionary and N.valid(JSON.parse_string(JSON.stringify(large_delta))),"large adjustment uses v1 transport")
	check(not N.valid({"v":2,"base":base,"sign":-1,"delta":1,"places":0,"extra":0}),"extra compact field rejected")
	check(not N.valid({"v":2,"base":{"m":1.0,"e":1.0},"sign":-1,"delta":11,"places":0}),"negative compact result rejected")
	check(not N.valid({"v":2,"base":base,"sign":1,"delta":9007199254740992.0,"places":0}),"unsafe bare JSON delta rejected")
	var fractional_coefficient={"v":2,"base":base,"sign":-1,"delta":1.5,"places":0}
	check(not C.valid(fractional_coefficient) and C.change(fractional_coefficient,0,1)==null,"fractional coefficient rejected before normalization")
	var carry=C.change({"m":9.0,"e":1000000000.0},1,-1)
	var carry_income=N.add(carry,{"m":2.0,"e":1000000000.0})
	check(N.valid(carry_income) and N.compare(carry_income,C.change({"m":1.1,"e":1000000001.0},1,-1))==0,"same-exponent income carries without losing debit")
	var adjacent_high=N.add(carry,{"m":2.0,"e":1000000001.0})
	check(N.valid(adjacent_high) and N.compare(adjacent_high,C.change({"m":2.9,"e":1000000001.0},1,-1))==0,"adjacent higher-exponent income carries exactly")
	var adjacent_low=N.add(carry,{"m":2.0,"e":999999999.0})
	check(N.valid(adjacent_low) and N.compare(adjacent_low,C.change({"m":9.2,"e":1000000000.0},1,-1))==0,"adjacent lower-exponent income retains debit")
	var db:=ShipDatabase.new()
	var game:=BattleGame.new(db,false)
	game.profile.highestLevel=999
	game.profile.resources={"1":base.duplicate(true),"2":base.duplicate(true)}
	check(game.upgrade_slot("weapons",0),"real distant purchase")
	var old_wallet=game.profile.resources.duplicate(true)
	var old_dirty:bool=game.save_dirty
	var events:Array=[]
	game.event.connect(func(kind,payload):events.append(kind))
	var allowed_drop:Dictionary={"id":"1","amount":{"m":2.0,"e":1000000001.0},"age":100.0}
	game.drops.append(allowed_drop)
	game.collect(allowed_drop,true)
	check(not game.drops.has(allowed_drop) and N.valid(game.profile.resources["1"]) and N.compare(game.profile.resources["1"],old_wallet["1"])>0,"real adjacent-exponent income accepted")
	var income_save=JSON.parse_string(JSON.stringify(game.portable_save_data()))
	check(preload("res://scripts/save_transfer.gd").new().prepare_data(income_save,db).error=="","large income peak portable validation")
	var income_reloaded:=BattleGame.new(db,false)
	income_reloaded.load_progress_data(income_save)
	check(N.compare(income_reloaded.profile.furnaceIncomePeak,game.profile.furnaceIncomePeak)==0,"large income peak survives reload")
	old_wallet=game.profile.resources.duplicate(true)
	events.clear()
	var drop:Dictionary={"id":"1","amount":{"m":1.0,"e":1000000100.0},"age":100.0}
	game.drops.append(drop)
	game.collect(drop,true)
	check(game.drops.has(drop) and game.profile.resources==old_wallet and game.save_dirty==old_dirty and events.is_empty(),"unsupported remote income rejects atomically")
	print("S12_COMPACT failures=",failures)
	quit(1 if failures else 0)
