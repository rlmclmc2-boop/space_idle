# Keep the project and original design workbook together.
/*
!/.gitignore
!/AGENTS.md
!/太空战舰.xlsx
!/space-battleship/
!/启动.cmd
!/test/
!/build_release.bat

# Dependencies and language caches
**/node_modules/
**/__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local environment and credentials
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.ssh/
*.pem
*.key

# Logs, temporary files, editor locks and backups
*.log
*.tmp
*.temp
*.codex-temp
*.bak
*.blend[0-9]
*.swp
*.swo
*.orig
*.rej
~$*
.DS_Store
Thumbs.db
desktop.ini
