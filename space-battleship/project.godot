; Space Battleship · Godot 4
config_version=5

[application]
config/name="太空战舰 · 深空远征"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="数据驱动的横版放置自动战斗游戏"
config/version="0.2.0"

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.037, 0.068, 1)
