+## Environment coordinates are independent of the fitted globe/facility viewport.
+func set_environment_rect(rect: Rect2) -> void:
+	if environment_rect == rect: return
+	environment_rect = rect
+	_layout_environment()
+
+func _layout_environment() -> void:
+	var rect := environment_rect if environment_rect.has_area() else Rect2(Vector2.ZERO, size)
+	background_layer.position = rect.position
+	background_layer.size = rect.size
+	nebula_layer.position = rect.position
+	nebula_layer.size = rect.size
+	background_layer.queue_redraw()
