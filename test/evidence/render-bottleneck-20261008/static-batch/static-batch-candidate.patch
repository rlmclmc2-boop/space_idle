diff --git a/space-battleship/scripts/static_ship_batch.gd b/space-battleship/scripts/static_ship_batch.gd
new file mode 100644
index 0000000..9224a33
--- /dev/null
+++ b/space-battleship/scripts/static_ship_batch.gd
@@ -0,0 +1,189 @@
+extends RefCounted
+## Presentation-only batching of authored static hulls, before modules/effects attach.
+## Cache lifetime is one PresentedShipView; moving carriers remain separate instances.
+
+const INSTANCE_PROPERTIES := [
+	"layers", "cast_shadow", "gi_mode", "extra_cull_margin",
+	"ignore_occlusion_culling", "lod_bias", "transparency",
+	"visibility_range_begin", "visibility_range_end",
+	"visibility_range_begin_margin", "visibility_range_end_margin",
+	"visibility_range_fade_mode", "sorting_offset", "sorting_use_aabb_center",
+]
+var cache: Dictionary = {}
+
+
+func apply(root: Node3D, source_path: String) -> void:
+	if not cache.has(source_path):
+		cache[source_path] = _build(root)
+	var batch: Dictionary = cache[source_path]
+	if batch.is_empty(): return
+	# Resolve everything before changing any instance. Keep nodes and socket paths.
+	var originals: Array[MeshInstance3D] = []
+	for path in batch.paths:
+		var original := root.get_node_or_null(path) as MeshInstance3D
+		if original == null: return
+		originals.append(original)
+	var merged := MeshInstance3D.new()
+	merged.name = "StaticHullBatch"
+	merged.mesh = batch.mesh
+	for property in INSTANCE_PROPERTIES:
+		merged.set(property, batch.state[property])
+	root.add_child(merged)
+	for original in originals:
+		original.mesh = null
+
+
+func _build(root: Node3D) -> Dictionary:
+	var parts: Array[Dictionary] = []
+	if not _collect(root, root, Transform3D.IDENTITY, parts): return {}
+	if parts.size() < 2: return {}
+	var state: Dictionary = parts[0].state
+	var groups: Dictionary = {}
+	var paths: Array[NodePath] = []
+	var original_surface_count := 0
+	for part in parts:
+		if part.state != state: return {}
+		paths.append(part.path)
+		var source: ArrayMesh = part.mesh
+		# ArrayMesh's storage property retains the imported LOD index buffers.
+		# surface_get_arrays alone omits them. Unknown storage layouts stay unbatched.
+		var stored: Variant = source.get("_surfaces")
+		if not stored is Array or stored.size() != source.get_surface_count(): return {}
+		for surface in source.get_surface_count():
+			if source.surface_get_primitive_type(surface) != Mesh.PRIMITIVE_TRIANGLES: return {}
+			var material := source.surface_get_material(surface) as StandardMaterial3D
+			if material == null or material.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED: return {}
+			var arrays: Array = source.surface_get_arrays(surface)
+			# Preserve every supported attribute; don't reinterpret custom or skin data.
+			for slot in [Mesh.ARRAY_CUSTOM0, Mesh.ARRAY_CUSTOM1, Mesh.ARRAY_CUSTOM2,
+					Mesh.ARRAY_CUSTOM3, Mesh.ARRAY_BONES, Mesh.ARRAY_WEIGHTS]:
+				if arrays[slot] != null and not arrays[slot].is_empty(): return {}
+			if not arrays[Mesh.ARRAY_VERTEX] is PackedVector3Array: return {}
+			var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+			if vertices.is_empty(): return {}
+			var decoded: Dictionary = _read_lods(stored[surface], vertices.size())
+			if not decoded.valid: return {}
+			# Current authored hull parts use translation only. Retain other assets
+			# verbatim instead of changing normal/tangent handedness or LOD scale.
+			for index in vertices.size():
+				vertices[index] += part.offset
+			arrays[Mesh.ARRAY_VERTEX] = vertices
+			if arrays[Mesh.ARRAY_INDEX] == null or arrays[Mesh.ARRAY_INDEX].is_empty():
+				var sequential := PackedInt32Array()
+				sequential.resize(vertices.size())
+				for index in vertices.size(): sequential[index] = index
+				arrays[Mesh.ARRAY_INDEX] = sequential
+			var key: int = material.get_instance_id()
+			if not groups.has(key): groups[key] = {"material": material, "pieces": []}
+			groups[key].pieces.append({"arrays": arrays, "lods": decoded.lods})
+			original_surface_count += 1
+	if groups.size() >= original_surface_count: return {}
+	var result := ArrayMesh.new()
+	var shadow := ArrayMesh.new()
+	for group in groups.values():
+		var combined: Dictionary = _join(group.pieces)
+		if combined.is_empty(): return {}
+		result.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, combined.arrays, [], combined.lods)
+		result.surface_set_material(result.get_surface_count() - 1, group.material)
+		# Same positions and LOD indices, position-only shadow input. Shadows remain
+		# enabled; no geometry simplification or different shadow silhouette.
+		var shadow_arrays: Array = []
+		shadow_arrays.resize(Mesh.ARRAY_MAX)
+		shadow_arrays[Mesh.ARRAY_VERTEX] = combined.arrays[Mesh.ARRAY_VERTEX]
+		shadow_arrays[Mesh.ARRAY_INDEX] = combined.arrays[Mesh.ARRAY_INDEX]
+		shadow.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, shadow_arrays, [], combined.lods)
+	result.shadow_mesh = shadow
+	return {"mesh": result, "paths": paths, "state": state}
+
+
+func _collect(root: Node3D, node: Node, relative: Transform3D, parts: Array[Dictionary]) -> bool:
+	# Authored animation, scripts, and skeletons must retain their own render nodes.
+	if node is AnimationPlayer or node is AnimationTree or node is Skeleton3D: return false
+	if node.get_script() != null: return false
+	var transform := relative
+	if node != root and node is Node3D:
+		if not node.visible or node.top_level: return false
+		transform = relative * node.transform
+	if node is MeshInstance3D:
+		var instance := node as MeshInstance3D
+		var mesh := instance.mesh as ArrayMesh
+		if not (node.name == &"HullArmor" or (str(node.name).begins_with("Engine") and str(node.name).ends_with("Mesh"))): return false
+		if mesh == null or mesh.get_blend_shape_count() != 0 or instance.skin != null: return false
+		if not transform.basis.is_equal_approx(Basis.IDENTITY): return false
+		if instance.material_override != null or instance.material_overlay != null: return false
+		if instance.custom_aabb != AABB(): return false
+		for surface in mesh.get_surface_count():
+			if instance.get_surface_override_material(surface) != null: return false
+		var state: Dictionary = {}
+		for property in INSTANCE_PROPERTIES: state[property] = instance.get(property)
+		parts.append({"path": root.get_path_to(node), "mesh": mesh,
+			"offset": transform.origin, "state": state})
+	for child in node.get_children():
+		if not _collect(root, child, transform, parts): return false
+	return true
+
+
+func _read_lods(surface: Variant, vertex_count: int) -> Dictionary:
+	if not surface is Dictionary: return {"valid": false}
+	var stored: Variant = surface.get("lods", [])
+	if not stored is Array or stored.size() % 2 != 0: return {"valid": false}
+	var lods: Dictionary = {}
+	# Godot stores 16-bit indices through 65536 vertices, otherwise 32-bit.
+	var stride := 2 if vertex_count <= 65536 else 4
+	for entry in range(0, stored.size(), 2):
+		if not (stored[entry] is float or stored[entry] is int): return {"valid": false}
+		var edge: float = float(stored[entry])
+		if edge <= 0.0 or not stored[entry + 1] is PackedByteArray: return {"valid": false}
+		var bytes: PackedByteArray = stored[entry + 1]
+		if bytes.is_empty() or bytes.size() % (stride * 3) != 0: return {"valid": false}
+		var indices := PackedInt32Array()
+		indices.resize(bytes.size() >> (1 if stride == 2 else 2))
+		for index in indices.size():
+			var vertex: int = bytes.decode_u16(index * stride) if stride == 2 else bytes.decode_u32(index * stride)
+			if vertex >= vertex_count: return {"valid": false}
+			indices[index] = vertex
+		lods[edge] = indices
+	return {"valid": true, "lods": lods}
+
+
+func _join(pieces: Array) -> Dictionary:
+	var joined: Array = pieces[0].arrays.duplicate(true)
+	var thresholds: Array[float] = []
+	var offsets: Array[int] = [0]
+	for edge in pieces[0].lods: thresholds.append(float(edge))
+	for piece_index in range(1, pieces.size()):
+		var arrays: Array = pieces[piece_index].arrays
+		var offset: int = joined[Mesh.ARRAY_VERTEX].size()
+		offsets.append(offset)
+		for slot in Mesh.ARRAY_MAX:
+			if slot == Mesh.ARRAY_INDEX: continue
+			if (joined[slot] == null) != (arrays[slot] == null): return {}
+			if joined[slot] != null:
+				if typeof(joined[slot]) != typeof(arrays[slot]): return {}
+				joined[slot].append_array(arrays[slot])
+		joined[Mesh.ARRAY_INDEX].append_array(_offset_indices(arrays[Mesh.ARRAY_INDEX], offset))
+		for edge in pieces[piece_index].lods:
+			if not thresholds.has(float(edge)): thresholds.append(float(edge))
+	thresholds.sort()
+	var lods: Dictionary = {}
+	# At each original transition retain every piece's original index selection.
+	# This view uses an orthographic camera; all parts share one LOD distance.
+	for edge in thresholds:
+		var indices := PackedInt32Array()
+		for piece_index in pieces.size():
+			var piece: Dictionary = pieces[piece_index]
+			var selected: PackedInt32Array = piece.arrays[Mesh.ARRAY_INDEX]
+			var selected_edge := 0.0
+			for candidate in piece.lods:
+				if float(candidate) <= edge and float(candidate) > selected_edge:
+					selected_edge = float(candidate)
+					selected = piece.lods[candidate]
+			indices.append_array(_offset_indices(selected, offsets[piece_index]))
+		lods[edge] = indices
+	return {"arrays": joined, "lods": lods}
+
+
+func _offset_indices(source: PackedInt32Array, offset: int) -> PackedInt32Array:
+	var indices: PackedInt32Array = source.duplicate()
+	for index in indices.size(): indices[index] += offset
+	return indices
